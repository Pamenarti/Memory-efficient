# Auto detect text files and perform LF normalization
* text=auto

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Source code
*.cs text diff=csharp
*.html text diff=html
*.css text
*.js text
*.json text
*.xml text

# Solution and project files
*.sln text eol=crlf
*.csproj text eol=crlf
*.vbproj text eol=crlf
*.config text

# Batch Scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# Exclude files from exporting
.gitattributes export-ignore
.gitignore export-ignore